{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "goldie-listing-factory-staging",
  "account_id": "81acaa875c17f523e6b248516ffac0e5",
  "main": "./dist/server/scheduled-entry.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // Sold Overnight keeps the corpus current on its own. Every twenty minutes
  // is a bounded slice, not a full sweep — the schedule is what makes the
  // board current, and the feature's own daily ceiling is what keeps it cheap.
  "triggers": { "crons": ["*/20 * * * *"] },
  "no_bundle": true,
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "thegoldiesuite.com", "custom_domain": true },
    { "pattern": "www.thegoldiesuite.com", "custom_domain": true }
  ],
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goldie-listing-factory-db",
      "database_id": "42a9eb4d-d434-4590-ac69-0f8a77d5885d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTWORK",
      "bucket_name": "goldie-listing-factory-artwork"
    }
  ],
  "images": { "binding": "IMAGES" },
  "workflows": [{"binding":"DRAFT_CREATION","name":"goldie-draft-creation","class_name":"DraftCreationWorkflow"},{"binding":"PHOTO_DELIVERY","name":"goldie-photo-delivery","class_name":"PhotoDeliveryWorkflow"}],
  "vars": {
    "GOLDIE_SITE_URL": "https://thegoldiesuite.com",
    "ETSY_REDIRECT_URI": "https://thegoldiesuite.com/api/etsy/callback",
    "STRIPE_STARTER_MONTHLY_PRICE_ID": "price_1UD9rSGT9xM3GmXOAkNHuFW2",
    "STRIPE_STARTER_YEARLY_PRICE_ID": "price_1UD9rtGT9xM3GmXOdLO0cc2O",
    "STRIPE_PRO_MONTHLY_PRICE_ID": "price_1UD9reGT9xM3GmXON0DEWh2k",
    "STRIPE_PRO_YEARLY_PRICE_ID": "price_1UD9rxGT9xM3GmXO0QqK56P7",
    "STRIPE_SCALE_MONTHLY_PRICE_ID": "price_1UD9riGT9xM3GmXOAZrt0gFE",
    "STRIPE_SCALE_YEARLY_PRICE_ID": "price_1UD9sKGT9xM3GmXOLzQD4lCJ",
    "STRIPE_GOLDIE_PRICE_ID": "price_1U5VndGT9xM3GmXOsLB36B4q",
    "STRIPE_SCALE_PRICE_ID": "price_1U5VnyGT9xM3GmXOdrR7D5BF"
  },
  "observability": { "enabled": true }
}
